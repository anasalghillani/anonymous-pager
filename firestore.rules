rules_version = '2';

// All writes go through Cloud Functions (Admin SDK bypasses these rules).
// Clients signed in with Firebase Anonymous Auth may only read their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParty(data) {
      return signedIn()
        && (data.senderId == request.auth.uid || data.receiverId == request.auth.uid);
    }

    match /pairs/{pairId} {
      allow read: if isParty(resource.data);
      allow write: if false;
    }

    match /ringReceipts/{receiptId} {
      allow read: if isParty(resource.data);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
